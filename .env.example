# Copy this file to .env and fill in real values. Never commit .env.

# --- Supabase ---
# Project Settings > Database > Connection string (use the "Transaction" pooler for DATABASE_URL,
# and the "Session" pooler for DIRECT_URL — Prisma needs both for migrations to work
# correctly against Supabase's pooled connection).
#
# DO NOT use the "URI" / direct connection Supabase also offers
# (db.[project-ref].supabase.co) for either variable — that host resolves
# to an IPv6 address ONLY, no IPv4, and will fail with "Can't reach
# database server" on any network without full IPv6 (common on home/ISP
# networks). Always use the aws-0-[region].pooler.supabase.com host below,
# which is IPv4-reachable, for both DATABASE_URL and DIRECT_URL.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI (extraction + drafting only — never used for eligibility decisions) ---
# Free key from https://build.nvidia.com
NVIDIA_API_KEY=""

# --- Auth ---
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# --- Daily sweep job (Stage 11/14) ---
# Generate with: openssl rand -base64 32. Set the same value in Vercel's
# project env vars — Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=""

# --- Notifications (Stage 9) ---
# Email is real (not a stub) once RESEND_API_KEY is set — wired into lawyer
# approval/rejection and the daily-sweep escalation digest. Free tier at
# https://resend.com. NOTIFICATION_FROM_EMAIL is optional; defaults to
# Resend's shared testing address, which only delivers to your own
# Resend account email until you verify a domain.
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL=""

# SMS (OTP) is still a console.log stub without these — Twilio needs a paid
# account, so this wasn't wired to a real send in this pass.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- One-off: bootstrap the first District Admin (v5 Stage 0) ---
# Only needed to run `npm run db:bootstrap-admin` once. Not read anywhere else.
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_BAR_NO=""          # format STATE/NUMBER/YEAR, e.g. TN/1234/2015
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_MOBILE=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_DISTRICT_ID=""     # optional, defaults to the seeded pilot district
